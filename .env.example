# ── Servidor (opcional em dev, OBRIGATÓRIO em produção) ──
# APP_ORIGIN: origem que o CORS aceita (história 4.1). Sem definir, assume
# http://localhost:3000 — em produção isso bloquearia o próprio frontend.
APP_ORIGIN=
# Porta da aplicação (padrão: 3000)
PORT=
# Interface de rede em que o servidor escuta (padrão: 127.0.0.1, só a
# própria máquina). Em produção o Caddy fala por dentro, então NÃO mude —
# abrir isso deixaria a aplicação acessível sem TLS e permitiria forjar
# X-Forwarded-For pra furar o rate limit. Use 0.0.0.0 só em container.
HOST=

# ── IA (opcional — só para os modos agente/gemini) ──
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# ── Supabase (obrigatório — ver supabase/README.md, passo 1) ──
SUPABASE_URL=https://bafsvszjpztbmbhmcwqk.supabase.co
# Chave "anon public" — vai para o frontend, segura para expor
SUPABASE_ANON_KEY=
# Chave "service_role secret" — SÓ backend, ignora RLS, nunca expor
SUPABASE_SERVICE_ROLE_KEY=

# ── Pix (história 2.5 — confirmação MANUAL pelo admin, fila da 6.3) ──
# Sem PIX_CHAVE, /api/compras com metodo=pix_manual responde 503.
PIX_CHAVE=
PIX_NOME_RECEBEDOR=
PIX_CIDADE=

# ── Cartão via Mercado Pago (história 2.7 — confirmação AUTOMÁTICA) ──
# Sem MERCADOPAGO_ACCESS_TOKEN, /api/compras com metodo=mercadopago responde
# 503 e o resto do sistema segue funcionando normalmente.
# Access token: painel do Mercado Pago → Suas integrações → aplicação →
# Credenciais. Use as de TESTE enquanto estiver homologando.
MERCADOPAGO_ACCESS_TOKEN=
# Segredo da assinatura do webhook: mesmo painel → Webhooks → configurar
# notificações. SEM ISSO O WEBHOOK REJEITA TUDO (401) — é o que impede que
# qualquer um poste na URL pública e ganhe créditos de graça.
MERCADOPAGO_WEBHOOK_SECRET=

# ── Logs (opcional — histórias 5.1/5.2) ──
# LOG_LEVEL: trace|debug|info|warn|error (padrão: info)
LOG_LEVEL=
# Pasta dos arquivos de log rotacionados (padrão: ./logs)
LOG_DIR=
# Quantos arquivos diários manter (padrão: 30 — rotação é diária, então
# equivale a "reter N dias")
LOG_RETENCAO_DIAS=

# ── Alertas de erro (opcional — história 5.3) ──
# DSN de um projeto Sentry (conta free em sentry.io) — sem isso, o app
# funciona normal, só sem captura de exceções externas.
SENTRY_DSN=

